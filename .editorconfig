# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# 2 space indentation for JSON, YAML, TypeScript, JavaScript
[*.{json,yml,yaml,ts,tsx,js,jsx}]
indent_style = space
indent_size = 2

# 2 space indentation for Clojure
[*.{clj,cljs,cljc}]
indent_style = space
indent_size = 2

# 2 space indentation for CSS
[*.{css,scss,less}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Batch files (Windows)
[*.{bat,cmd}]
end_of_line = crlf
